<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NuLigaViewer.Pages.SettingsPage"
             Title="Einstellungen">

    <Grid Padding="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Picker Grid.Row="0" Title="Gewünschte Textgröße:" HeightRequest="70"
                ItemsSource="{Binding AvailableTextSizes}"
                SelectedItem="{Binding TextSize}" />
    </Grid>
</ContentPage>