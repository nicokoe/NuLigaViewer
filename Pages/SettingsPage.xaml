<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NuLigaViewer.Pages.SettingsPage"
             Title="Einstellungen">

    <Grid Padding="8">
        <Grid.Resources>

        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="5*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Label Style="{StaticResource SettingsLeftLabelStyle}" Grid.Row="0" Grid.Column="0">Schriftbreite</Label>
        <Picker x:Name="DDLFontWidth" Grid.Row="0" Grid.Column="1" Title="" SelectedIndexChanged="OnFontWidthChanged">
            <Picker.Items>
                <x:String>Normal</x:String>
                <x:String>95 %</x:String>
                <x:String>88 %</x:String>
                <x:String>78 %</x:String>
                <x:String>65 %</x:String>
            </Picker.Items>
        </Picker>

    </Grid>
</ContentPage>